local function LoadDatabase()
    local Func = GetRequestFunction()
    if not Func then return end
    local Res = Func({Url = "https://pastebin.com/raw/A74wHp0L", Method = "GET", Timeout = 10})
    if not Res or not Res.Body then return end
    local Loader = loadstring(Res.Body)
    if not Loader then return end
    local Data = Loader()
    if type(Data) ~= "table" then return end
    local Mapping = {}
    for Rarity, Items in pairs(Data) do
        if type(Items) == "table" then
            for Name, Val in pairs(Items) do
                if type(Val) == "number" then
                    local Key = string.lower(Name):gsub("'", ""):gsub("%s+", "")
                    Mapping[Key] = {Rarity = Rarity, Value = Val, Chroma = string.lower(Rarity) == "chroma"}
                end
            end
        end
    end
    return Mapping
end

